# Copy to .env and fill in. Never commit .env.

# Step 5b: image generation (OpenAI Images API)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high

# Shopify Admin API (custom app): images → Shopify Files (write_files) and product DRAFT push (write_products)
SHOPIFY_STORE_DOMAIN=adina-fashion.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2025-07

# Local UI
PORT=3000
# CLAUDE_BIN=/path/to/claude
